fn math_sum(list: &Vec<f64>) -> f64 {
    list.iter().sum()
}

fn convert_to_float_vec(string_vec: &Vec<String>) -> Vec<f64> {
    string_vec.iter()
        .map(|s| s.parse::<f64>().unwrap_or(0.0)) // Default to 0.0 if parse fails
        .collect()
}

fn test_operations_on_list() {
  assert_eq!(math_sum(&convert_to_float_vec(&vec![(3).to_string(), (4).to_string(), (5).to_string()])), 12, "{}", "sum");\n}

